# Copy this file to ".env" and paste your key(s) after the "=".
# Get a free key: https://console.cloud.google.com -> new project ->
# "Enable APIs" -> YouTube Data API v3 -> Credentials -> Create API key.
# With a key set, the engine uses the fast official API; without it, it
# falls back to yt-dlp scraping automatically. No quotes needed.
#
# Multiple keys (each from a SEPARATE Google Cloud project = separate 10k/day
# quota): when one key's daily quota runs out, the next takes over automatically.
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=
YOUTUBE_API_KEY_4=
